# Copy to .env next to compose.yaml and fill in.

# Who may open Settings (emails or usernames from Pangolin's sign-in, comma-separated).
HUB_ADMINS=

# The Docker network Pangolin or Newt is on (README step 2). Default: pangolin_frontend
# PANGOLIN_NETWORK=

# Optional: a connection set here instead of in Settings.
# PANGOLIN_API_URL=https://api.pangolin.net/v1
# PANGOLIN_API_KEY=
# PANGOLIN_ORG_ID=
